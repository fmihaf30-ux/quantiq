# Leave these empty to run in DEMO mode (local mock backend + accelerated synthetic market).
# Fill both to switch the web app to LIVE mode against your Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Edge Function secrets (NOT read by Vite). Set them with:
#   supabase secrets set GEMINI_API_KEY=... METAAPI_TOKEN=... RUNNER_SECRET=...
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# METAAPI_TOKEN=
# METAAPI_REGION=new-york
# RUNNER_SECRET=   # random string; pg_cron sends it to bot-runner
